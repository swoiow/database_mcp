# Admin API auth: when set, /admin/api requires
# "Authorization: Bearer <ADMIN_TOKEN>" (also used by the admin UI).
# Leave empty only for local dev (startup will warn).
ADMIN_TOKEN=change-me-to-a-long-random-string

# Cache (gateway MCP tools accept per-call use_cache/ttl, defaults below)
DBMCP_CACHE_ENABLED=false
DBMCP_CACHE_TTL=60

# Runtime guards
DBMCP_QUERY_TIMEOUT=30        # seconds; tool calls are cancelled past this
DBMCP_MAX_ROWS=10000          # hard server-side cap for execute_sql max_rows
DBMCP_RATE_LIMIT_PER_MIN=120  # tool calls per (user, endpoint) per minute

# Observability
DBMCP_AUDIT_PATH=audit.log     # JSONL, one record per MCP tool call
DBMCP_METERING_PATH=metering.json  # aggregated usage counters

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DB=demo

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=secret
PG_DB=demo
